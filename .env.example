DJANGO_SECRET_KEY=replace-with-strong-secret
DEBUG=False
ALLOWED_HOSTS=class.alshifalab.pk,localhost,127.0.0.1
TIME_ZONE=Asia/Karachi

# Routing source of truth (must match Caddy upstreams)
APP_DOMAIN=class.alshifalab.pk
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_BIND_PORT=9030
BACKEND_BIND_HOST=127.0.0.1
BACKEND_BIND_PORT=9031

POSTGRES_DB=classdb
POSTGRES_USER=classuser
POSTGRES_PASSWORD=classpass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://class.alshifalab.pk/api/auth/google/callback
FRONTEND_URL=https://class.alshifalab.pk

# Note: adding spreadsheets.readonly scope means existing users must re-authenticate
# once to grant the new permission. The import endpoint returns a clear error until they do.

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

CORS_ALLOWED_ORIGINS=https://class.alshifalab.pk
CSRF_TRUSTED_ORIGINS=https://class.alshifalab.pk
